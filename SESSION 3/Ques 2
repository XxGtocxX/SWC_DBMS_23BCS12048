WITH ordered AS (
    SELECT
        product_id,
        product_name,
        month_start,
        monthly_active_users,
        LEAD(month_start, 1) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS growth_start_month,
        LEAD(monthly_active_users, 1) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u5,
        LEAD(monthly_active_users, 2) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u6,
        LEAD(monthly_active_users, 3) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u7,
        LEAD(monthly_active_users, 4) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u8,
        monthly_active_users AS u1,
        LEAD(monthly_active_users, 1) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u2,
        LEAD(monthly_active_users, 2) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u3,
        LEAD(monthly_active_users, 3) OVER (
            PARTITION BY product_id
            ORDER BY month_start
        ) AS u4
    FROM product_engagement
),
turnarounds AS (
    SELECT
        product_id,
        product_name,
        month_start AS decline_start_month,
        growth_start_month,
        u4 AS lowest_users,
        GREATEST(u5, u6, u7, COALESCE(u8, u7)) AS peak_users
    FROM ordered
    WHERE
        u1 > u2
        AND u2 > u3
        AND u3 > u4          -- 3 consecutive declines
        AND u4 < u5
        AND u5 < u6
        AND u6 < u7          -- 3 consecutive growth months
)
SELECT
    product_name,
    decline_start_month,
    growth_start_month,
    ROUND(
        (peak_users - lowest_users) * 1.0 / lowest_users,
        4
    ) AS growth_ratio
FROM turnarounds
ORDER BY product_name;