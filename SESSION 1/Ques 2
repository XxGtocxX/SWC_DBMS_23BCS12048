WITH dates AS (
    SELECT generate_series(
        DATE '2025-04-15',
        DATE '2025-04-28',
        INTERVAL '1 day'
    )::date AS transaction_date
),

purchases AS (
    SELECT
        transaction_id,
        transaction_date,
        amount
    FROM product_sales
    WHERE product_id = 'PROD-2891'
      AND country = 'US'
      AND status = 'completed'
      AND type = 'purchase'
      AND transaction_date BETWEEN DATE '2025-04-15'
                               AND DATE '2025-04-28'
),

refunds AS (
    SELECT
        r.original_transaction_id,
        r.amount
    FROM product_sales r
    JOIN purchases p
      ON r.original_transaction_id = p.transaction_id
    WHERE r.type = 'refund'
      AND r.status = 'completed'
),

daily_revenue AS (
    SELECT
        p.transaction_date,
        SUM(p.amount) AS purchase_amount
    FROM purchases p
    GROUP BY p.transaction_date
),

daily_refunds AS (
    SELECT
        p.transaction_date,
        SUM(r.amount) AS refund_amount
    FROM purchases p
    JOIN refunds r
      ON p.transaction_id = r.original_transaction_id
    GROUP BY p.transaction_date
)

SELECT
    d.transaction_date,
    COALESCE(dr.purchase_amount, 0)
    - COALESCE(df.refund_amount, 0) AS daily_net_revenue
FROM dates d
LEFT JOIN daily_revenue dr
       ON d.transaction_date = dr.transaction_date
LEFT JOIN daily_refunds df
       ON d.transaction_date = df.transaction_date
ORDER BY d.transaction_date;